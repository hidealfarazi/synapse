# Salin menjadi .env.local (JANGAN di-commit). Tanpa awalan NEXT_PUBLIC_ agar tidak ikut ke browser.
GEMINI_API_KEY=isi_kunci_dari_google_ai_studio
GEMINI_MODEL=gemini-3.7-flash
AI_ENABLED=true
AI_DAILY_CALLS=15
AI_DAILY_ASKS=10
AI_OWNER_KEY=

# Firebase — Salin dari Firebase Console > Project Settings > General > Your apps (Web app SDK Config)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nama-proyek.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nama-proyek
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nama-proyek.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
