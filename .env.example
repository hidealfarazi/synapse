# Salin menjadi .env.local (JANGAN di-commit). Tanpa awalan NEXT_PUBLIC_ agar tidak ikut ke browser.
GEMINI_API_KEY=isi_kunci_dari_google_ai_studio
GEMINI_MODEL=gemini-3.7-flash
AI_ENABLED=true
AI_DAILY_CALLS=15
AI_DAILY_ASKS=10
# Wajib saat AI_ENABLED=true: permintaan API harus menyertakan header x-owner-key.
# Jangan taruh nilai ini di client / NEXT_PUBLIC_. Untuk produksi AI masih dinonaktifkan
# sampai login server-side dan penyimpanan kuota atomik persisten tersedia.
AI_OWNER_KEY=

# Supabase — Project Settings > API. Publishable key memang publik; keamanan data dijaga RLS.
# JANGAN pernah memasukkan service_role / secret key ke sini atau ke kode klien.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
